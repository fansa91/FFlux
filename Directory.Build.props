<Project>

  <!-- Platform configuration -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Product version, single source of truth for every project in the repo.
       The release pipeline overrides it with -p:Version=<tag without the v>, which also
       lands in AssemblyVersion / FileVersion / AssemblyInformationalVersion, so the exe
       file properties, the Settings page caption and the artefact names all agree.
       Starts at 0.1.0: the app is pre-1.0 while the WinUI 3 port settles. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Company>fansa92</Company>
    <Product>FFlux Player</Product>
  </PropertyGroup>

  <!-- Language configuration -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Output path configuration -->
  <PropertyGroup>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- Trimming switches -->
  <PropertyGroup>
    <CsWinRTAotWarningLevel>3</CsWinRTAotWarningLevel>

    <!-- C#/WinRT size-saving options:
         Disable dynamic object support to reduce binary size. Manifest-free
         activation is kept on for the unpackaged build (see below).
         References:
         https://github.com/microsoft/CsWinRT/blob/2.3.1.260716.1/nuget/readme.md#advanced-size-saving-options
         https://github.com/microsoft/CsWinRT/pull/1887
    -->
    <CsWinRTEnableDynamicObjectsSupport>false</CsWinRTEnableDynamicObjectsSupport>

    <!-- MUST stay enabled for the unpackaged build. With WindowsPackageType=None there
         is no APPX manifest declaring activatable classes, so third-party WinRT
         components (FFmpegInteropX.MediaSourceConfig and friends) cannot be resolved
         by RoGetActivationFactory (REGDB_E_CLASSNOTREG). CsWinRT's manifest-free
         fallback locates the component DLL from the sibling .winmd instead. The
         original UWP/MSIX build had package metadata and could disable this for size. -->
    <CsWinRTEnableManifestFreeActivation>true</CsWinRTEnableManifestFreeActivation>

    <!-- WinRT does not require 'INotifyPropertyChanging' support.
         References:
         https://github.com/CommunityToolkit/dotnet/pull/911
         https://github.com/microsoft/CsWinRT/pull/2358
    -->
    <MvvmToolkitEnableINotifyPropertyChangingSupport>false</MvvmToolkitEnableINotifyPropertyChangingSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Use C#/WinRT 2.3.1 directly to enable improved AOT analysis.
         The Windows 26100 SDK uses an older version lacking these enhancements. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
  </ItemGroup>

  <!-- Global usings -->
  <ItemGroup>
    <Using Include="WinRT" />
  </ItemGroup>

</Project>