<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <!-- Code namespace stays Screenbox.Lively.* even though the project file is FFlux.Lively. -->
    <RootNamespace>Screenbox.Lively</RootNamespace>
    <!-- Keep the assembly name aligned with the namespace it exposes. -->
    <AssemblyName>Screenbox.Lively</AssemblyName>
    <!-- No UseUwp: the windows TFM supplies the Windows SDK WinRT projection. -->
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <IsAotCompatible>true</IsAotCompatible>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFlux.Core\FFlux.Core.csproj" />
  </ItemGroup>
</Project>