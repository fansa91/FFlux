<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <!-- The project file and the assembly are named FFlux, but the code namespace stays
         Screenbox.* so the resw-generated Resources class keeps its Screenbox.Strings
         namespace. Without this, renaming the project file would silently move every
         generated resource accessor to FFlux.Strings. -->
    <RootNamespace>Screenbox</RootNamespace>
    <!-- WinUI 3 / Windows App SDK. UseUwp belongs to the UWP project model and is gone. -->
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged deployment: build a plain .exe into the output folder, never an MSIX.
         Combined with WindowsAppSDKSelfContained below, the SDK targets switch from the
         runtime bootstrapper to registration-free WinRT activation. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <!-- Ship the Windows App SDK runtime next to the exe, so neither release needs a
         separately installed Windows App Runtime. Both flavours keep this on and differ
         only in whether the .NET runtime travels along. Do not pass it as a global -p:
         from the pipeline: Windows App SDK rejects the property on class libraries. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Product name and binary name are the two things Windows shows outside the app's own
         UI: the exe filename in Task Manager / Explorer, and the FileDescription in the
         property sheet. Keep them here rather than in code so both follow one definition. -->
    <AssemblyName>FFlux</AssemblyName>
    <!-- Product, Company and Version are defined once in Directory.Build.props so the
         release pipeline can stamp all of them from the git tag. -->
    <!-- An unpackaged app gets its taskbar / Alt+Tab / Explorer icon from the PE resource,
         not from a package manifest logo, so the icon has to be embedded in the exe. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Disable generated Main for custom Main in Program.cs with multi-instancing support. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Keep the SDK default PRI items enabled. Disabling them here dropped every
         XAML page, style and library theme resource from resources.pri, so every
         ms-appx:/// lookup failed at startup in the unpackaged app. Only the
         incomplete translations are filtered out below. -->
  </PropertyGroup>

  <ItemGroup Label="Unpackaged build">
    <!-- Retained only as the file-type-association reference for a future installer.
         An unpackaged app has no package identity, so this manifest is inert: the
         54 associations and all capabilities must be registered by an installer instead. -->
    <AppxManifest Remove="Package.appxmanifest" />
    <None Remove="Package.appxmanifest" />
    <None Include="Package.appxmanifest" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Use application languages for plural rules to avoid mismatches with the system display language. -->
    <ReswPlusUseApplicationLanguages>true</ReswPlusUseApplicationLanguages>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- WinUI 3 counterparts of the former CommunityToolkit.Uwp.* packages.
         Versions match (8.2.251219) and the CLR/XAML namespaces were already
         CommunityToolkit.WinUI.*, so XAML prefixes need no changes. -->
    <PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
    <!-- Top-level FFmpegInteropX selects the Desktop lib/FFmpeg build for WinUI 3.
         The FFmpegMediaSource API is unchanged; only the packaged binaries differ. -->
    <PackageReference Include="FFmpegInteropX" Version="2.1.0.81200" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
    <PackageReference Include="Sentry.Extensions.Logging" Version="6.12.1" />
    <PackageReference Include="ReswPlus" Version="0.6.1" />
  </ItemGroup>

  <ItemGroup Label="Localization">
    <!-- Default PRI items already include **\*.resw. Only pending translations are
         removed here. Remove the language below when a translation is complete. -->
    <PRIResource Remove="Strings\af-ZA\*.resw" />
    <PRIResource Remove="Strings\ca-ES\*.resw" />
    <PRIResource Remove="Strings\cs-CZ\*.resw" />
    <PRIResource Remove="Strings\da-DK\*.resw" />
    <PRIResource Remove="Strings\fa-IR\*.resw" />
    <PRIResource Remove="Strings\no-NO\*.resw" />
    <PRIResource Remove="Strings\sr-SP\*.resw" />
    <PRIResource Remove="Strings\sv-SE\*.resw" />
    <PRIResource Remove="Strings\ta-IN\*.resw" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFlux.Core\FFlux.Core.csproj" />
    <ProjectReference Include="..\FFlux.Lively\FFlux.Lively.csproj" />
    <ProjectReference Include="..\FFlux.UI\FFlux.UI.csproj" />
  </ItemGroup>

  <!-- Unpackaged WinUI 3 resolves ms-appx:/// XAML against loose files next to the exe.
       The XAML compiler emits library-relative URIs such as
       ms-appx:///Controls/XamlControlsResources.xaml for x:Class dictionaries, while
       the referenced class library lays its XBF files out under Screenbox.UI/. Mirror
       them into the unqualified paths as well; the assembly-qualified copies are kept
       for the Source="ms-appx:///Screenbox.UI/..." references inside those files. -->
  <Target Name="FlattenLibraryXamlResources" AfterTargets="Build">
    <ItemGroup>
      <_LibraryXamlResource Include="$(OutDir)Screenbox.UI\**\*.xbf" />
      <_LibraryXamlResource Include="$(OutDir)Screenbox.UI\**\*.xaml" />
    </ItemGroup>
    <Copy SourceFiles="@(_LibraryXamlResource)"
          DestinationFiles="@(_LibraryXamlResource->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Runtime resource lookups (ResourceLoader, ms-appx:/// string and XBF resolution) read
       resources.pri next to the exe. With WindowsPackageType=None nothing owns that name, and
       the incremental build only refreshes the project PRI (<AssemblyName>.pri), so
       resources.pri silently rots: newly added .resw keys then throw "NamedResource not found"
       at runtime while the build stays green. Keep the runtime copy in step with the freshly
       generated project PRI. Derived from AssemblyName so a rename does not silently disable it. -->
  <Target Name="SyncRuntimePri" AfterTargets="FlattenLibraryXamlResources" Condition="Exists('$(OutDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri"
          DestinationFiles="$(OutDir)resources.pri"
          SkipUnchangedFiles="true" />
  </Target>

</Project>