<Page
    x:Class="Screenbox.Pages.StreamsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Screenbox.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Screenbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Screenbox.Core.Models"
    xmlns:sbuc="using:Screenbox.UI.Controls"
    xmlns:strings="using:Screenbox.Strings"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: title on the left, search on the right  -->
        <Grid
            x:Name="HeaderGrid"
            Grid.Row="0"
            MinHeight="{StaticResource PageHeaderMinHeight}"
            Margin="{StaticResource BottomMediumMargin}"
            Padding="{StaticResource ContentPagePadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="HeaderText"
                VerticalAlignment="Center"
                Style="{StaticResource TitleMediumTextBlockStyle}"
                Text="{x:Bind strings:Resources.NetworkStreams}" />

            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                Width="240"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind strings:Resources.NetworkStreamsSearchPlaceholder}"
                PlaceholderText="{x:Bind strings:Resources.NetworkStreamsSearchPlaceholder}"
                TextChanged="SearchBox_OnTextChanged" />
        </Grid>

        <!--  Quick add bar  -->
        <Grid
            x:Name="QuickAddGrid"
            Grid.Row="1"
            Margin="{StaticResource ContentPagePadding}"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="QuickAddBox"
                AutomationProperties.Name="{x:Bind strings:Resources.NetworkStreamsQuickAddPlaceholder}"
                KeyDown="QuickAddBox_OnKeyDown"
                PlaceholderText="{x:Bind strings:Resources.NetworkStreamsQuickAddPlaceholder}"
                Text="{x:Bind ViewModel.QuickAddUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Grid.Column="1"
                Click="AddButton_OnClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Margin="8,0,0,0" Text="{x:Bind strings:Resources.NetworkStreamsAdd}" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Saved links  -->
        <ListView
            x:Name="StreamsList"
            Grid.Row="2"
            Padding="{StaticResource ContentPagePadding}"
            AutomationProperties.Name="{x:Bind strings:Resources.NetworkStreams}"
            IsItemClickEnabled="True"
            ItemClick="StreamsList_OnItemClick"
            ItemsSource="{x:Bind ViewModel.VisibleStreams, Mode=OneWay}"
            KeyDown="StreamsList_OnKeyDown"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:StreamItem">
                    <Grid Padding="0,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Format badge, e.g. HLS / RTSP / MP4  -->
                        <Border
                            Grid.Column="0"
                            MinWidth="56"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind BadgeText, Mode=OneWay}" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Url, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Width="36"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="PlayButton_OnClick"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.Play}">
                                <FontIcon FontSize="14" Glyph="&#xE768;" />
                            </Button>
                            <Button
                                Width="36"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="RenameButton_OnClick"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.Rename}">
                                <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                            </Button>
                            <Button
                                Width="36"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="EditButton_OnClick"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.Edit}">
                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                            </Button>
                            <Button
                                Width="36"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="DeleteButton_OnClick"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.Delete}">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Nothing saved yet  -->
        <sbuc:ContentUnavailableView
            x:Name="EmptyPanel"
            Grid.Row="2"
            Padding="{StaticResource ContentPagePadding}"
            Title="{x:Bind strings:Resources.NetworkStreamsEmptyTitle}"
            IsOpen="{x:Bind ViewModel.IsLibraryEmpty, Mode=OneWay}"
            Message="{x:Bind strings:Resources.NetworkStreamsEmptyMessage}">
            <FontIcon
                FontSize="{StaticResource NoContentPanelIconFontSize}"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="&#xE774;" />
        </sbuc:ContentUnavailableView>

        <!--  Saved links exist, but the search matched nothing  -->
        <TextBlock
            Grid.Row="2"
            Margin="0,32,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="{x:Bind strings:Resources.NetworkStreamsNoMatch}"
            Visibility="{x:Bind ViewModel.IsFilterEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="NavigationViewStates">
                <VisualState x:Name="Expanded" />
                <VisualState x:Name="Compact" />
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <ui:IsEqualStateTrigger Value="{x:Bind Common.NavigationViewDisplayMode, Mode=OneWay}" To="{StaticResource MinimalNavigationViewDisplayMode}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderGrid.Padding" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="QuickAddGrid.Margin" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="StreamsList.Padding" Value="{StaticResource GridViewContentPageMinimalPadding}" />
                        <Setter Target="SearchBox.Width" Value="160" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
