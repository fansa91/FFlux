<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <!-- WinUI 3 / Windows App SDK. UseUwp belongs to the UWP project model and is gone. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Disable generated Main for custom Main in Program.cs with multi-instancing support. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Disable default PRI items to manually control which languages are included in the app package. -->
    <EnableDefaultPriItems>false</EnableDefaultPriItems>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <GenerateTemporaryStoreCertificate>False</GenerateTemporaryStoreCertificate>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateAppxPackageOnBuild Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</GenerateAppxPackageOnBuild>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x86|x64|arm64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    
    <MicrosoftWindowsSdkBuildToolsMSIXPackageVersion>1.7.261102100</MicrosoftWindowsSdkBuildToolsMSIXPackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Use application languages for plural rules to avoid mismatches with the system display language. -->
    <ReswPlusUseApplicationLanguages>true</ReswPlusUseApplicationLanguages>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- WinUI 3 counterparts of the former CommunityToolkit.Uwp.* packages.
         Versions match (8.2.251219) and the CLR/XAML namespaces were already
         CommunityToolkit.WinUI.*, so XAML prefixes need no changes. -->
    <PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Behaviors" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
    <!-- Top-level FFmpegInteropX selects the Desktop lib/FFmpeg build for WinUI 3.
         The FFmpegMediaSource API is unchanged; only the packaged binaries differ. -->
    <PackageReference Include="FFmpegInteropX" Version="2.1.0.81200" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
    <PackageReference Include="Sentry.Extensions.Logging" Version="6.12.1" />
    <PackageReference Include="ReswPlus" Version="0.6.1" />
  </ItemGroup>

  <ItemGroup Label="Localization">
    <PRIResource Include="**\*.resw" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <!-- Pending translations are explicitly removed. Remove the language below when a translation is complete. -->
    <PRIResource Remove="Strings\af-ZA\*.resw" />
    <PRIResource Remove="Strings\ca-ES\*.resw" />
    <PRIResource Remove="Strings\cs-CZ\*.resw" />
    <PRIResource Remove="Strings\da-DK\*.resw" />
    <PRIResource Remove="Strings\fa-IR\*.resw" />
    <PRIResource Remove="Strings\no-NO\*.resw" />
    <PRIResource Remove="Strings\sr-SP\*.resw" />
    <PRIResource Remove="Strings\sv-SE\*.resw" />
    <PRIResource Remove="Strings\ta-IN\*.resw" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Screenbox.Core\Screenbox.Core.csproj" />
    <ProjectReference Include="..\Screenbox.Lively\Screenbox.Lively.csproj" />
    <ProjectReference Include="..\Screenbox.UI\Screenbox.UI.csproj" />
  </ItemGroup>

</Project>